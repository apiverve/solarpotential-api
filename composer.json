        "solarpotential",
        "solar potential api",
        "solar radiation lookup",
        "pv yield estimation",
        "calculate sunlight hours",
        "optimal solar panel direction"
    ],
    "homepage": "https://apiverve.com/marketplace/solarpotential?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/solarpotential",
        "source": "https://github.com/apiverve/solarpotential-API/tree/main/php"
    },
    "require": {
